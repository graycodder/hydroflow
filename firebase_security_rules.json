{
    "rules": {
        "Agencies": {
            ".read": true,
            ".write": true,
            ".indexOn": [
                "ownerId"
            ],
            "$agencyId": {
                "stock": {
                    ".validate": true
                },
                "stats": {
                    ".validate": true
                }
            }
        },
        "Salesmen": {
            ".indexOn": [
                "agencyId",
                "phone",
                "username"
            ],
            ".read": true,
            ".write": true
        },
        "Customers": {
            ".indexOn": [
                "agencyId",
                "salesmanId",
                "phone",
                "zone"
            ],
            ".read": true,
            ".write": true
        },
        "Transactions": {
            ".indexOn": [
                "agencyId",
                "salesmanId",
                "customerId",
                "timestamp"
            ],
            ".read": true,
            ".write": true
        },
        "Stock_logs": {
            ".indexOn": [
                "salesmanId",
                "date",
                "agencyId"
            ],
            ".read": true,
            ".write": true
        },
        "Agency_Stock_History": {
            ".read": true,
            ".write": true
        },
        "Subscription_logs": {
            ".read": true,
            ".write": false
        },
        "Plans": {
            ".read": true,
            ".write": true
        },
        "Subscriptions": {
            ".indexOn": [
                "salesmanId",
                "status",
                "expiryDate",
                "agencyId"
            ],
            ".read": true,
            ".write": true
        },
        "app_config": {
            ".read": true,
            ".write": false
        },
        "Notifications": {
            ".read": true,
            ".write": true
        },
        "Settlements": {
            ".read": true,
            ".write": true
        }
    }
}